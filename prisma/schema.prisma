// RD-AISEC data model — engagements and their findings.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon -pooler host) for the app at runtime.
  url       = env("DATABASE_URL")
  // Direct, NON-pooled connection for migrations — pooled/PgBouncer connections
  // can't hold the advisory lock `prisma migrate deploy` needs (P1002 timeout).
  directUrl = env("DIRECT_URL")
}

// A unit of work: a pentest, forensics case, or consulting engagement.
model Engagement {
  id           String    @id @default(cuid())
  name         String
  client       String    @default("")
  // "pentest" | "forensics" | "consulting"
  type         String    @default("pentest")
  // "planning" | "active" | "completed"
  status       String    @default("planning")
  scope        String    @default("")
  // Free-form category/tag for grouping (e.g. a platform like "HackerOne", or
  // a manual label). Auto-set to the platform for bug-bounty engagements.
  category     String    @default("")
  // White-box source recon: an https git repo URL the runner clones + analyzes.
  sourceRepo   String    @default("")
  // Authenticated-scan session, ENCRYPTED at rest (see lib/crypto). A single HTTP
  // header — a session cookie or bearer token — injected into header-capable
  // tools so scans run as the logged-in user (reaches IDOR / access-control /
  // business-logic bugs). Decrypted only server-side at job-serve time.
  authSession  String    @default("")
  authorized   Boolean   @default(false)
  authorizedBy String    @default("")
  ownerEmail   String    @default("")
  findings     Finding[]
  resources    Resource[]
  jobs         Job[]
  scans        ScanRun[]
  schedules    ScheduledScan[]
  bugPrograms  BugProgram[]
  pipeline     Pipeline?
  evidence     Evidence[]
  assessments  Assessment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A guided, approval-gated assessment run for one engagement. Stages execute in
// order (recon → scan → exploit → triage → report); when a stage finishes the
// pipeline waits for approval (unless autoApprove) then runs the next, until the
// report is ready. One pipeline per engagement.
model Pipeline {
  id           String          @id @default(cuid())
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String          @unique
  runnerId     String          @default("")
  // "running" | "awaiting_approval" | "done" | "paused" | "canceled"
  status       String          @default("running")
  currentKey   String          @default("recon") // stage key currently active
  autoApprove  Boolean         @default(false)    // skip approval gates when true
  deep         Boolean         @default(false)    // heavier args: all ports, bigger lists, vuln scripts
  ownerEmail   String          @default("")
  stages       PipelineStage[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// One stage within a pipeline.
model PipelineStage {
  id         String    @id @default(cuid())
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  pipelineId String
  key        String // recon|scan|exploit|triage|report
  title      String
  order      Int
  // "pending" | "running" | "done" | "skipped"
  status     String    @default("pending")
  summary    String    @default("")
  startedAt  DateTime?
  finishedAt DateTime?
}

// A catalog entry in the Resource Vault. The actual file lives offline (e.g. on
// an external drive) — we store only the metadata + a link or drive location.
model Resource {
  id           String      @id @default(cuid())
  title        String
  // "link" | "book" | "exploit" | "tool" | "cheatsheet" | "other"
  type         String      @default("link")
  url          String      @default("") // online resources
  location     String      @default("") // offline drive label, e.g. "SSD:/Books/nmap.pdf"
  tags         String      @default("")
  notes        String      @default("")
  ownerEmail   String      @default("")
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  engagementId String?
  createdAt    DateTime    @default(now())
}

// ── Digital Forensics ────────────────────────────────────────────────────────
// A piece of acquired evidence in a forensics engagement, with an integrity hash
// and a chain-of-custody log so handling is auditable.
model Evidence {
  id           String         @id @default(cuid())
  engagement   Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  name         String
  // "disk" | "memory" | "file" | "log" | "network" | "mobile" | "cloud" | "other"
  kind         String         @default("file")
  source       String         @default("") // where it came from (device, path, host)
  hashAlgo     String         @default("sha256")
  hashValue    String         @default("") // integrity hash of the acquired image/file
  size         String         @default("") // human size, e.g. "500 GB"
  storage      String         @default("") // where the image is stored (drive/vault)
  acquiredBy   String         @default("")
  acquiredAt   DateTime       @default(now())
  notes        String         @default("")
  custody      CustodyEvent[]
  createdAt    DateTime       @default(now())

  @@index([engagementId])
}

// One link in an evidence item's chain of custody.
model CustodyEvent {
  id         String   @id @default(cuid())
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceId String
  // "acquired" | "transferred" | "analyzed" | "stored" | "released" | "note"
  action     String   @default("note")
  actor      String   @default("")
  notes      String   @default("")
  at         DateTime @default(now())

  @@index([evidenceId])
}

// ── Security Consulting ──────────────────────────────────────────────────────
// A control/maturity assessment against a framework (CIS, NIST CSF, ASVS…). Each
// control gets a result + maturity level; the rollup drives the advisory report.
model Assessment {
  id           String          @id @default(cuid())
  engagement   Engagement      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  name         String
  framework    String          @default("custom") // template id
  notes        String          @default("")
  controls     ControlResult[]
  createdAt    DateTime        @default(now())

  @@index([engagementId])
}

model ControlResult {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  controlId    String     // stable id from the framework template
  domain       String     @default("")
  title        String
  // "pass" | "partial" | "fail" | "na"
  status       String     @default("na")
  maturity     Int        @default(0) // 0..5
  notes        String     @default("")
  recommendation String   @default("")

  @@index([assessmentId])
}

// A registered execution host (e.g. a Kali VM in UTM on an external drive).
// The portal queues Jobs; the runner polls over HTTPS, executes them locally,
// and posts results back. The token is stored hashed; the plaintext is shown
// to the user exactly once at creation.
model Runner {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  ownerEmail String    @default("")
  lastSeenAt DateTime?
  version    String    @default("") // runner script version it reports
  toolCount  Int       @default(0)  // number of tools the runner has loaded
  maxWorkers Int       @default(3)  // how many jobs this machine runs in parallel
  anonymity  Boolean   @default(false) // desired: route tool traffic via Tor
  exitIp     String    @default("")    // Tor exit IP the runner reports when on
  anonStatus String    @default("")    // off | connecting | on | no-tor (reported)
  subnets    String    @default("")    // comma-separated local CIDRs the runner detected
  wifi       String    @default("")    // comma-separated wireless interface names
  wifiMonitor Boolean  @default(false) // any adapter supports monitor mode
  installed  String    @default("")    // comma-separated tool ids whose binary is present
  cpuPct     Int?      // last reported CPU utilisation %
  memPct     Int?      // last reported RAM utilisation %
  memUsedMb  Int?      // RAM in use (MB)
  memTotalMb Int?      // total RAM (MB)
  diskUsedMb Int?      // root filesystem used (MB)
  diskTotalMb Int?     // root filesystem total (MB)
  cores      Int?      // logical CPU cores
  uptimeSec  Int?      // seconds since boot
  gpuPct     Int?      // GPU utilisation %
  batteryPct Int?      // battery charge %
  charging   Boolean?  // on AC / charging
  powerW     Int?      // instantaneous power draw (W)
  tempC      Int?      // last reported CPU temperature °C
  loadAvg    String    @default("") // reported "1m 5m 15m" load averages
  createdAt  DateTime  @default(now())
  jobs       Job[]
  installs   Install[]
}

// A request to install a tool's package on a runner (authorized by the user).
model Install {
  id          String    @id @default(cuid())
  runner      Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  runnerId    String
  tool        String
  // "pending" | "installing" | "done" | "failed"
  status      String    @default("pending")
  output      String    @default("")
  exitCode    Int?
  requestedBy String    @default("")
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
}

// A single tool execution queued by the portal and run by a Runner.
// engagementId is OPTIONAL: a "quick scan" (e.g. the runner's own network) has
// no engagement; engagement scans are the formal, scope-gated ones.
model Job {
  id           String      @id @default(cuid())
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  engagementId String?
  runner       Runner?     @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  runnerId     String?
  // allowlisted tool id, e.g. "nmap" | "nuclei" | "httpx" | "whois" | "dig"
  tool         String
  // validated target (in-scope host/URL)
  target       String
  // validated, space-separated tool flags (no shell metacharacters)
  args         String     @default("")
  // "queued" | "running" | "done" | "failed" | "canceled"
  status       String     @default("queued")
  // Queue priority: higher runs first. The runner claims queued jobs ordered by
  // priority desc, then createdAt asc (same-priority stays first-come). 0 =
  // normal; "Run next" / "Run first" bumps a job above all other queued jobs.
  priority     Int        @default(0)
  output       String     @default("") // raw tool output (capped)
  exitCode     Int?
  queuedBy     String     @default("") // user email, for audit
  // Assessment-pipeline stage that queued this job (recon|scan|exploit). Empty
  // for ad-hoc/bug-bounty jobs. Pipeline jobs suppress the auto-exploit chain so
  // the pipeline's own approval gates control progression.
  stage        String     @default("")
  // When true, results are parsed into findings automatically on completion
  // (used by bug-bounty automation, which has no human in the loop).
  autoImport   Boolean    @default(false)
  // Archived jobs are hidden from the default History view but kept on record.
  archived     Boolean    @default(false)
  // Self-healing: how many times the portal has auto-retried this work after a
  // recoverable runner-side failure. Bounded so it can't loop forever.
  retries      Int        @default(0)
  createdAt    DateTime   @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  // Serves the runner's claim query (per runner, queued, by priority then age).
  @@index([runnerId, status, priority(sort: Desc), createdAt])
}

// A single issue discovered during an engagement.
model Finding {
  id             String     @id @default(cuid())
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId   String
  title          String
  // "info" | "low" | "medium" | "high" | "critical"
  severity       String     @default("medium")
  // "open" | "fixed" | "accepted" | "false_positive"
  status         String     @default("open")
  description    String     @default("")
  recommendation String     @default("")
  // Framework tags (deterministic mapping — see lib/finding-map.ts).
  // MITRE ATT&CK tactic id (e.g. "TA0001") and OWASP Top 10 id (e.g. "A03"); "" = unmapped.
  attack         String     @default("")
  owasp          String     @default("")
  // Set when automated validation proved the issue is exploitable (glows in UI).
  confirmed      Boolean    @default(false)
  // Human-review sign-off: high-impact findings (RCE/auth/IDOR/SSRF/ATO/payment/
  // critical) must be approved by an owner before they're published/submitted.
  reviewed       Boolean    @default(false)
  // Free-form category/tag for grouping (e.g. "web", "infra", "to-report").
  category       String     @default("")
  // Comma-joined tool ids that independently detected this issue (cross-tool
  // corroboration). Grows as signature-matching duplicates are merged in; a
  // count >1 means multiple tools agreed. NOT a proof signal — display only.
  sources        String     @default("")
  createdAt      DateTime   @default(now())
}

// A single reconnaissance/security scan run. Tracks scan execution history,
// results, and progress for trend analysis and audit trail.
model ScanRun {
  id             String     @id @default(cuid())
  engagement     Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId   String
  target         String     // URL, IP, or domain being scanned
  scanType       String     // "dns" | "port" | "web" | "posture" | "osint"
  // "pending" | "running" | "completed" | "failed"
  status         String     @default("pending")
  progress       Int        @default(0) // 0-100 percentage
  result         String     @default("{}") // JSON: parsed scan results
  error          String     @default("") // error message if failed
  durationMs     Int        @default(0) // execution time in ms
  createdAt      DateTime   @default(now())
  completedAt    DateTime? // when scan finished
}

// A recurring passive web-posture scan. The Vercel cron hits /api/cron/scan,
// which runs every enabled schedule whose interval has elapsed and saves new
// findings to its engagement (deduped against existing open findings).
model ScheduledScan {
  id           String      @id @default(cuid())
  targets      String      // newline/comma-separated URLs (<= MAX_BULK_TARGETS)
  engagement   Engagement  @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  // "daily" | "weekly"
  frequency    String      @default("daily")
  enabled      Boolean     @default(true)
  ownerEmail   String      @default("")
  lastRunAt    DateTime?
  lastStatus   String      @default("") // human summary of the last run
  createdAt    DateTime    @default(now())
}

// A team member who can sign in (by email) once approved by an owner, with
// access scoped to specific dashboard sections. Owners (AUTHORIZED_EMAILS env)
// always have full access and aren't stored here.
model Member {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String    @default("")
  // "owner" grants everything; "member" is scoped by `access`.
  role        String    @default("member")
  // Comma-separated grantable item keys (nav hrefs); "*" = everything.
  access      String    @default("")
  // "approved" can sign in; "pending"/"suspended" cannot.
  status      String    @default("approved")
  invitedBy   String    @default("")
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

// Notification settings (single config). Posts to a Discord/Slack-compatible
// webhook when a new finding at/above minSeverity lands (e.g. from automation).
model NotifySetting {
  id             String   @id @default(cuid())
  ownerEmail     String   @default("")
  discordWebhook String   @default("")
  minSeverity    String   @default("high") // info|low|medium|high|critical
  enabled        Boolean  @default(true)
  // Research / exploit workspace.
  driveUrl       String   @default("") // Google Drive folder link (reference)
  exploitDir     String   @default("") // Kali folder where generated exploits are saved
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A saved bug-bounty platform account (handle/profile link). No secrets stored
// by default — it's a convenience pointer to where the programs live.
model BugAccount {
  id             String    @id @default(cuid())
  platform       String    @default("hackerone") // hackerone | bugcrowd | intigriti | yeswehack | other
  handle         String    @default("")
  url            String    @default("") // profile / dashboard link
  // HackerOne API sync (token stored encrypted at rest; never returned to client).
  apiUser        String    @default("") // HackerOne API username
  apiToken       String    @default("") // encrypted API token
  lastSyncAt     DateTime?
  lastSyncStatus String    @default("")
  ownerEmail     String    @default("")
  createdAt      DateTime  @default(now())
}

// Per-user progress on a learning topic (topics themselves live in data/learn.ts).
model LearnProgress {
  id         String   @id @default(cuid())
  key        String // topic id from data/learn.ts
  ownerEmail String   @default("")
  // "todo" | "learning" | "done"
  status     String   @default("todo")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([key, ownerEmail])
}

// A bug-bounty program the user is working: its scope (pasted or linked) and an
// optional link to an engagement so the portal's scanning/exploitation applies.
model BugProgram {
  id           String      @id @default(cuid())
  platform     String      @default("hackerone")
  name         String
  url          String      @default("") // program/brief link
  scope        String      @default("") // in-scope targets, one per line
  outScope     String      @default("") // explicitly out-of-scope
  notes        String      @default("")
  reward       String      @default("") // e.g. "$$$ / swag"
  // Free-form category/tag for grouping (e.g. "web", "mobile", "priority").
  category     String      @default("")
  status       String      @default("active") // active | paused | archived
  // Automation: when `auto` is on, the daily cron runs the recon/vuln pipeline
  // against in-scope targets using `autoRunnerId`.
  auto         Boolean     @default(false)
  autoRunnerId String      @default("")
  lastAutoAt   DateTime?
  ownerEmail   String      @default("")
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  engagementId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// SIEM / audit trail: a security-relevant event recorded for the activity
// timeline — logins, logouts, jobs queued, findings created, report exports, etc.
// Append-only; surfaced at /dashboard/siem and feeds the rail's activity view.
model AuditEvent {
  id        String   @id @default(cuid())
  // Dotted event type, e.g. "auth.login" | "auth.logout" | "job.queued" |
  // "finding.created" | "report.exported".
  type      String
  actor     String   @default("") // email of who did it ("" = system/cron)
  summary   String   @default("") // human-readable one-liner
  target    String   @default("") // optional subject (host, finding id, …)
  severity  String   @default("info") // info | low | medium | high | critical
  meta      String   @default("")     // small JSON blob (capped)
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([actor, createdAt])
}

// Learned false-positive suppression. When an operator marks a finding as a
// false positive, we derive a signature (vuln class + normalized title) and
// store it here; the import gate drops future candidates that match, so the
// engine improves itself from triage. Fully visible + removable (see
// /dashboard/findings → Learned rules).
model Suppression {
  id        String   @id @default(cuid())
  // "suppress" = learned false positive (drop matches); "allow" = learned from a
  // CONFIRMED finding (protect matches — allow always beats suppress).
  kind      String   @default("suppress")
  scope     String   @default("global") // "global" | "host"
  host      String   @default("")        // set when scope = "host"
  tool      String   @default("")        // "" = any tool
  vulnClass String   @default("")        // taxonomy class id ("" = any)
  titleKey  String                       // normalized title signature
  reason    String   @default("")        // why it's noise (from the sample)
  createdBy String   @default("")
  hits      Int      @default(0)         // times it has suppressed a finding
  createdAt DateTime @default(now())

  @@index([titleKey])
}

// Threat intelligence feed synced by a runner (which has internet egress) so the
// portal always has current data without needing outbound access itself. Today:
// the CISA KEV catalog (CVEs known to be actively exploited in the wild). One row
// per feed `kind`; `data` is a comma-joined list of CVE ids.
model ThreatFeed {
  id        String   @id @default(cuid())
  kind      String   @unique // "kev"
  data      String   @default("") // comma-joined CVE ids
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
