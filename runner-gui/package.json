{
  "name": "rdaisec-runner-gui",
  "productName": "RD-AISEC Runner",
  "version": "1.0.3",
  "description": "Desktop control panel for the RD-AISEC runner — connect a machine, monitor it, and control it from a window.",
  "main": "main.js",
  "author": "Kuldeep J.",
  "homepage": "https://github.com/rudraxdevelopment98-cell/RD-AISEC",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux --x64 --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rdaisec.runner",
    "productName": "RD-AISEC Runner",
    "files": ["main.js", "preload.js", "renderer/**"],
    "extraResources": [
      { "from": "../runner/rdaisec_runner.py", "to": "rdaisec_runner.py" }
    ],
    "publish": [
      { "provider": "github", "owner": "rudraxdevelopment98-cell", "repo": "RD-AISEC" }
    ],
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis", "portable"] },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "maintainer": "RD-AISEC <noreply@rd-aisec.app>"
    }
  }
}
