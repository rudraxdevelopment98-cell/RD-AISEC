# ── Database (Prisma + PostgreSQL) ─────────────────────────────────────
# Use a Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
# Then run `npx prisma migrate deploy` to create the tables.
# Example (Neon): postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/rdaisec"

# Direct (NON-pooled) connection — used ONLY for migrations. On Neon this is the
# same as DATABASE_URL but with "-pooler" removed from the host. Required so
# `prisma migrate deploy` can take its advisory lock (avoids the P1002 timeout).
# Example (Neon direct): postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require
DIRECT_URL="postgresql://user:password@localhost:5432/rdaisec"

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────
# Required. Generate one with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=

# ── OAuth providers ────────────────────────────────────────────────────
# Configure at least one. Each is auto-enabled only when both vars are set.
# GitHub:  https://github.com/settings/developers
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Preview deployments (optional). Vercel previews each get a unique URL, but
# OAuth providers only allow exact, pre-registered redirect URIs. Point this at
# your stable production "/api/auth" so all previews reuse production's single
# registered callback (fixes Error 400: redirect_uri_mismatch).
# IMPORTANT: set the SAME value on BOTH the Production and Preview environments —
# Auth.js only forwards the callback on the deployment whose origin matches this
# URL (production), so production must have it set too, or sign-in hangs there.
# Also requires AUTH_SECRET to be identical across production and preview.
# See GOOGLE-LOGIN.md → "Preview deployments".
# AUTH_REDIRECT_PROXY_URL=https://your-production-domain/api/auth

# ── Access control ─────────────────────────────────────────────────────
# Comma-separated allowlist of emails permitted to sign in.
# Leave empty to allow any successful OAuth login (tighten this in production!).
AUTHORIZED_EMAILS=

# ── Developer login (local dev ONLY — ignored in production) ───────────
# A username/password fallback so you can use the dashboard before wiring OAuth.
# Fails closed: it only activates when ALLOW_DEV_LOGIN=true, NODE_ENV is not
# production, AND you set your own DEV_LOGIN_PASSWORD below (no default). Leave
# these as-is for a safe deploy; set them only on your dev machine.
ALLOW_DEV_LOGIN=false
DEV_LOGIN_PASSWORD=

# ── AI backend (optional — features degrade cleanly when unset) ────────
# Powers AI recon browse (engagement → Command → "Run AI recon"): the AI reads
# your in-scope pages and suggests what to test. Owner + scope + SSRF gated.
# Costs nothing until set. @anthropic-ai/sdk is already a dependency.
# ANTHROPIC_API_KEY=
# Model for AI recon (optional; defaults to claude-sonnet-5).
# AI_BROWSE_MODEL=claude-sonnet-5
